@model BrandUpdateBrandViewModel;
@{
    ViewData["Title"] = "UpdateBrand";
}

<h1>@ViewData["Title"]</h1>

<form asp-area="Admin" asp-controller="Brand" asp-action="UpdateBrand" method="post" enctype="multipart/form-data">
    <input asp-for="BrandId" />
    <div class="mb-3">
        <label asp-for="BrandName" class="col-form-label"></label>
        <input asp-for="BrandName" class="form-control" />
        <span asp-validation-for="BrandName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BrandLogo" class="col-form-label"></label>
        <input asp-for="BrandLogo" class="form-control" />
    </div>

    <button class="btn btn-outline-dark" type="submit">Save</button>
    <a class="btn btn-outline-primary" asp-area="Admin" asp-route="BrandsAdminOverview">Cancel</a>
</form>