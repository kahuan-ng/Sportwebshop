@using Wba.PE02_Webshop.Web.ViewModels.FeatureViewModels
@model FeatureShowAttributeProductsViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" />
}

<div id="filter">
    <partial name="SideBarPartialView"></partial>
    <main id="catalog">
        <header>
            <h1>@ViewData["Title"]</h1>
            <p id="product-count">@Model.AttributeProducts.Count artikelen</p>
        </header>

        <section id="showcase-brandproducts-cards">
            @foreach (var ap in Model.AttributeProducts)
            {
               <partial name="ProductsPartialView" model="@ap"></partial>
            }
        </section>
    </main>
</div>