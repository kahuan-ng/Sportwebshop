@using Wba.PE02_Webshop.Web.ViewModels.CategoryViewModels
@model CategoryShowCategoryProductsViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" />
}
<div id="filter">
    <partial name="SideBarPartialView"></partial>

    <main id="catalog">
        <header>
            <h1>@ViewData["Title"]</h1>
            <p id="product-count">@Model.CategoryProducts.Count artikelen</p>
        </header>

        <section id="showcase-brandproducts-cards">
            @foreach (var cp in Model.CategoryProducts)
            {
                <partial name="ProductsPartialView" model="@cp"></partial>

            }
        </section>
    </main>
</div>